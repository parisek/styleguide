{
    "name": "parisek/styleguide",
    "description": "Twig component styleguide as a self-contained Composer package",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Petr Parimucha",
            "email": "tools@portadesign.cz"
        }
    ],
    "require": {
        "php": "^8.3",
        "parisek/twig-attribute": "^1.0",
        "parisek/twig-typography": "^1.0",
        "symfony/twig-bridge": "^5.4 || ^6.2 || ^7.0 || ^8.0",
        "symfony/var-dumper": "^5.4 || ^6.2 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.0 || ^7.0 || ^8.0",
        "twig/intl-extra": "^3.3",
        "twig/string-extra": "^3.3",
        "twig/twig": "^3.27"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Parisek\\Styleguide\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Parisek\\Styleguide\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/styleguide"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "scripts": {
        "check": [
            "@test",
            "@phpstan"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "phpstan": "php -d memory_limit=512M vendor/bin/phpstan analyse",
        "test": "vendor/bin/phpunit",
        "test:e2e": "bash tests/e2e/run.sh"
    }
}
