{# vendor/parisek/styleguide — Foundations body (logo + palette + typography preview).
   Rendered inside the iframe by Renderer when kind=foundations. Reads everything from
   `styleguide.*` (= the project's styleguide.yaml, merged in by Styleguide::dispatchRender).
   Project filters / functions (typography, create_attribute) flow through via the
   injected Twig environment. #}
<div class="px-4 py-6 md:px-6 md:py-8 lg:px-8">
	{% if styleguide.project %}
		<div class="mb-10">
			<h1 class="font-bold text-2xl sm:text-3xl lg:text-4xl text-zinc-900 tracking-tight">{{ styleguide.project.name|e }}</h1>
			{% if styleguide.project.description %}
				<p class="mt-3 max-w-3xl text-base lg:text-lg text-zinc-600 leading-relaxed">{{ styleguide.project.description|e }}</p>
			{% endif %}
		</div>
	{% endif %}

	{# Server-side favicon audit (#73) — always present with every entry
	   'unconfigured'/null when the `favicon:` yaml block is absent (see
	   Styleguide::dispatchRender). Hoisted above the logo section so its
	   `tab_icon`/`touch_icon`/`manifest.app_name` can drive the compact
	   mockups embedded in the logo card's FAVICON slot below (#73
	   follow-up — owner feedback: mockups belong next to the logo, not in
	   a separate three-card row). #}
	{% set favicon_audit = styleguide.favicon_audit %}

	{% if styleguide.logo %}
		<section id="logo" class="mb-12">
			<div class="flex gap-3 items-center mb-6">
				<div class="flex justify-center items-center w-8 h-8 rounded-lg bg-zinc-200 text-zinc-600">
					<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
					</svg>
				</div>
				<h2 class="font-bold text-lg text-zinc-900">{{ styleguide.labels.logo|e }}</h2>
			</div>
			<div class="overflow-hidden border border-zinc-200 rounded-xl shadow-lg shadow-zinc-200/50 bg-white">
				<div class="flex flex-col sm:flex-row sm:flex-wrap xl:flex-nowrap sm:items-stretch">
					{% for key, logo in styleguide.logo %}
						{% set logo_item_attrs = create_attribute({
							class: [
								'flex flex-1 flex-col p-6 md:p-8 min-w-0',
								'sm:w-1/2 xl:w-auto',
								'border-b last:border-b-0 last:border-r-0 sm:border-b-0 sm:border-r xl:border-r border-zinc-100',
							],
						}) %}
						<div{{ logo_item_attrs }}>
							<p class="mb-4 font-semibold text-xs text-zinc-500 uppercase tracking-wider">{{ (key == 'favicon' ? logo.label|default(styleguide.labels.favicon|default('Favicon')) : logo.label)|e }}</p>
							{% set logo_bg_attrs = create_attribute({
								class: [
									'flex items-center justify-center rounded-lg p-8 min-h-32 flex-1',
									logo.background == 'dark' ? 'bg-zinc-900' : 'bg-white',
								],
							}) %}
							{% set favicon_slot_has_mockups = key == 'favicon' and styleguide.favicon and (favicon_audit.tab_icon or favicon_audit.touch_icon) %}
							<div{{ logo_bg_attrs }}>
								{% if favicon_slot_has_mockups %}
									{# Compact browser-tab + iOS home-screen mockups replace the plain
									   favicon swatch (#73 follow-up) — visual economy is the point of
									   the owner feedback, so these are deliberately smaller than the
									   standalone cards the old #favicon section used to render. #}
									<div class="flex flex-col gap-3 items-center w-full">
										<div class="flex flex-col gap-1.5 w-full max-w-40">
											{% for tab_theme in ['light', 'dark'] %}
												{% set tab_bar_attrs = create_attribute({
													class: [
														'flex gap-1.5 items-center px-2 py-1 rounded text-[10px]',
														tab_theme == 'dark' ? 'bg-zinc-800 text-zinc-100' : 'bg-white text-zinc-700 border border-zinc-200',
													],
													'data-favicon-tab': tab_theme,
												}) %}
												<div{{ tab_bar_attrs }}>
													{% if favicon_audit.tab_icon %}
														{# twig-cs-fixer-disable-next-line PlainImg — mockup tab-bar favicon sourced from the server-side audit, not a CMS image #}
														<img src="{{ favicon_audit.tab_icon|e('html_attr') }}" alt="" width="12" height="12" class="w-3 h-3 shrink-0">
													{% else %}
														<span class="w-3 h-3 rounded-sm border border-dashed border-zinc-400 shrink-0"></span>
													{% endif %}
													<span class="flex-1 truncate">{{ styleguide.project.name|default('')|e }}</span>
												</div>
											{% endfor %}
										</div>
										{% if favicon_audit.touch_icon %}
											{# twig-cs-fixer-disable-next-line PlainImg — mockup iOS touch-icon sourced from the server-side audit, not a CMS image #}
											<img src="{{ favicon_audit.touch_icon|e('html_attr') }}" alt="" width="40" height="40" class="w-10 h-10 rounded-[22%] shadow">
										{% else %}
											<div class="flex justify-center items-center px-1 w-10 h-10 text-[8px] text-center text-zinc-400 rounded-[22%] border-2 border-dashed border-zinc-400">{{ styleguide.labels.favicon_ios_empty|default('No apple-touch-icon configured')|e }}</div>
										{% endif %}
										<span class="max-w-full text-[10px] text-zinc-500 truncate">{{ favicon_audit.manifest.app_name|default(styleguide.project.name)|e }}</span>
									</div>
								{% else %}
									{# twig-cs-fixer-disable-next-line PlainImg — static brand-logo asset from styleguide.yaml; component_picture would force a CMS-shape image array for a build-time SVG/PNG that has no resizing pipeline #}
									<img src="{{ logo.src|e('html_attr') }}" class="{{ (logo.size|default('w-full max-w-48 h-auto'))|e('html_attr') }}" alt="{{ logo.alt|e('html_attr') }}">
								{% endif %}
							</div>
						</div>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}

	{% if styleguide.favicon and styleguide.favicon_audit %}
		{% set favicon_status_classes = {
			ok: 'bg-emerald-50 text-emerald-700',
			warning: 'bg-amber-50 text-amber-700',
			error: 'bg-red-50 text-red-700',
			missing: 'bg-red-50 text-red-700',
			unconfigured: 'bg-zinc-100 text-zinc-400',
		} %}
		{% set favicon_status_glyphs = {
			ok: '✓',
			warning: '!',
			error: '✗',
			missing: '✗',
			unconfigured: '–',
		} %}
		<section id="favicon" class="mb-12">
			<div class="flex gap-3 items-center mb-6">
				<div class="flex justify-center items-center w-8 h-8 rounded-lg bg-zinc-200 text-zinc-600">
					<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
					</svg>
				</div>
				<h2 class="font-bold text-lg text-zinc-900">{{ styleguide.labels.favicon|default('Favicon')|e }}</h2>
			</div>

			{# Browser-tab + iOS mockups moved into the logo card's FAVICON slot
			   above (#73 follow-up — owner feedback); the Android/PWA maskable
			   mockup card was dropped outright. `maskable_icon` stays part of the
			   FaviconAudit contract (the manifest sub-rows below still audit it),
			   it's just no longer rendered as a standalone mockup. #}

			{# Audit checklist — collapsed by default via the same generic
			   [data-sg-toggle] pattern the contrast matrix uses (see
			   frontend/foundations.js). One row per fixed-order entry, then
			   manifest icon sub-rows / notes, then a theme_color row. Every
			   value here is a consumer string (yaml-configured path, note
			   text) and goes through the same |e / html_attr discipline as
			   the rest of this template. #}
			<button
				type="button"
				class="flex gap-2 items-center mb-4 font-semibold text-sm text-zinc-600 hover:text-zinc-900 transition-colors"
				data-sg-toggle="favicon-audit-table"
			>
				<svg class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
				</svg>
				{{ styleguide.labels.favicon_audit|default('Favicon audit')|e }}
			</button>
			<div id="favicon-audit-table" class="overflow-hidden overflow-x-auto border border-zinc-200 rounded-xl shadow-lg shadow-zinc-200/50 bg-white" hidden>
				<table class="w-full text-sm">
					<thead>
						<tr class="text-xs tracking-wider text-left text-zinc-500 uppercase bg-zinc-50 border-b border-zinc-100">
							<th class="px-4 py-2">{{ styleguide.labels.favicon_col_asset|default('Asset')|e }}</th>
							<th class="px-4 py-2">{{ styleguide.labels.favicon_col_path|default('Path')|e }}</th>
							<th class="px-4 py-2">{{ styleguide.labels.favicon_col_expected|default('Expected')|e }}</th>
							<th class="px-4 py-2">{{ styleguide.labels.favicon_col_actual|default('Actual')|e }}</th>
							<th class="px-4 py-2">{{ styleguide.labels.favicon_col_status|default('Status')|e }}</th>
							<th class="px-4 py-2">{{ styleguide.labels.favicon_col_note|default('Note')|e }}</th>
						</tr>
					</thead>
					<tbody>
						{% for entry in favicon_audit.entries %}
							{% set favicon_row_attrs = create_attribute({
								class: [
									'border-b border-zinc-50 last:border-b-0',
									entry.status == 'unconfigured' ? 'opacity-60' : '',
								],
								'data-favicon-entry': entry.key,
								'data-favicon-status': entry.status,
							}) %}
							<tr{{ favicon_row_attrs }}>
								<td class="px-4 py-2 font-medium text-zinc-800">{{ entry.label|e }}</td>
								<td class="px-4 py-2 font-mono text-xs text-zinc-500">
									{% if entry.configured %}
										<code>{{ entry.path|e }}</code>
									{% else %}
										<span class="text-zinc-300">{{ styleguide.labels.favicon_not_configured|default('not configured')|e }}</span>
									{% endif %}
								</td>
								<td class="px-4 py-2 font-mono text-xs text-zinc-500">{{ entry.expected|e }}</td>
								<td class="px-4 py-2 font-mono text-xs text-zinc-500">{% if entry.width is not null and entry.height is not null %}{{ entry.width }}×{{ entry.height }}{% endif %}</td>
								<td class="px-4 py-2">
									{% set favicon_badge_attrs = create_attribute({
										class: [
											'inline-flex gap-1 items-center px-2 py-0.5 rounded-full text-xs font-semibold',
											favicon_status_classes[entry.status]|default('bg-zinc-100 text-zinc-400'),
										],
									}) %}
									<span{{ favicon_badge_attrs }}>{{ favicon_status_glyphs[entry.status]|default('?') }} {{ (styleguide.labels['favicon_status_' ~ entry.status]|default(entry.status))|e }}</span>
								</td>
								<td class="px-4 py-2 text-xs text-zinc-500">{{ entry.note|e }}</td>
							</tr>
						{% endfor %}

						{% if favicon_audit.manifest %}
							{% for icon in favicon_audit.manifest.icons %}
								{% set favicon_icon_row_attrs = create_attribute({
									class: 'border-b border-zinc-50 last:border-b-0 bg-zinc-50/50',
									'data-favicon-manifest-icon': icon.src,
									'data-favicon-manifest-icon-exists': icon.exists ? 'true' : 'false',
								}) %}
								<tr{{ favicon_icon_row_attrs }}>
									<td class="px-4 py-2 pl-8 text-xs text-zinc-500">{{ styleguide.labels.favicon_manifest_icon|default('Manifest icon')|e }} <span class="text-zinc-400">({{ icon.purpose|e }})</span></td>
									<td class="px-4 py-2 font-mono text-xs text-zinc-500"><code>{{ icon.src|e }}</code></td>
									<td class="px-4 py-2 font-mono text-xs text-zinc-500">{{ icon.sizes|e }}</td>
									<td class="px-4 py-2"></td>
									<td class="px-4 py-2">
										{% set favicon_icon_badge_attrs = create_attribute({
											class: [
												'inline-flex gap-1 items-center px-2 py-0.5 rounded-full text-xs font-semibold',
												icon.exists ? 'bg-emerald-50 text-emerald-700' : 'bg-red-50 text-red-700',
											],
										}) %}
										<span{{ favicon_icon_badge_attrs }}>{% if icon.exists %}✓ {{ styleguide.labels.favicon_status_ok|default('ok')|e }}{% else %}✗ {{ styleguide.labels.favicon_status_missing|default('missing')|e }}{% endif %}</span>
									</td>
									<td class="px-4 py-2 text-xs text-zinc-500"></td>
								</tr>
							{% endfor %}
							{% for manifest_note in favicon_audit.manifest.notes %}
								<tr class="border-b border-zinc-50 last:border-b-0">
									<td class="px-4 py-2 pl-8 text-xs text-amber-700" colspan="6">! {{ manifest_note|e }}</td>
								</tr>
							{% endfor %}
						{% endif %}

						<tr class="border-b border-zinc-50 last:border-b-0">
							<td class="px-4 py-2 font-medium text-zinc-800">{{ styleguide.labels.favicon_theme_color|default('Theme color')|e }}</td>
							<td class="px-4 py-2" colspan="3">
								{% if favicon_audit.theme_color.configured and favicon_audit.theme_color.valid %}
									{% set favicon_swatch_attrs = create_attribute({
										class: 'block w-4 h-4 rounded border border-zinc-200',
										style: "background-color: #{favicon_audit.theme_color.value};",
									}) %}
									<span class="inline-flex gap-2 items-center">
										<span{{ favicon_swatch_attrs }}></span>
										<span class="font-mono text-xs text-zinc-600">{{ favicon_audit.theme_color.value|e }}</span>
									</span>
								{% else %}
									<span class="text-xs text-zinc-300">{{ styleguide.labels.favicon_not_configured|default('not configured')|e }}</span>
								{% endif %}
							</td>
							<td class="px-4 py-2">
								{% if favicon_audit.theme_color.configured and not favicon_audit.theme_color.valid %}
									<span class="inline-flex gap-1 items-center px-2 py-0.5 text-xs font-semibold text-red-700 bg-red-50 rounded-full">✗ {{ styleguide.labels.favicon_status_error|default('error')|e }}</span>
								{% elseif favicon_audit.theme_color.configured %}
									<span class="inline-flex gap-1 items-center px-2 py-0.5 text-xs font-semibold text-emerald-700 bg-emerald-50 rounded-full">✓ {{ styleguide.labels.favicon_status_ok|default('ok')|e }}</span>
								{% else %}
									<span class="inline-flex gap-1 items-center px-2 py-0.5 text-xs font-semibold text-zinc-400 bg-zinc-100 rounded-full">– {{ styleguide.labels.favicon_status_unconfigured|default('unconfigured')|e }}</span>
								{% endif %}
							</td>
							<td class="px-4 py-2 text-xs text-zinc-500">{% if favicon_audit.theme_color.configured and not favicon_audit.theme_color.valid %}{{ styleguide.labels.favicon_theme_color_invalid|default('invalid hex value')|e }}{% endif %}</td>
						</tr>
					</tbody>
				</table>
			</div>
		</section>
	{% endif %}

	{# Open Graph image section (#74) — unlike every other optional section
	   on this page, this one is NOT gated on the yaml key being present:
	   an OG image is expected on every project, so the section always
	   renders — an empty-state prompt when `og_image_audit.configured`
	   is false, three share-card mockups + an audit summary otherwise. #}
	{% if styleguide.og_image_audit %}
		{% set og_audit = styleguide.og_image_audit %}
		{% set og_status_classes = {
			ok: 'bg-emerald-50 text-emerald-700',
			warning: 'bg-amber-50 text-amber-700',
			error: 'bg-red-50 text-red-700',
			missing: 'bg-red-50 text-red-700',
			unconfigured: 'bg-zinc-100 text-zinc-400',
		} %}
		{% set og_status_glyphs = {
			ok: '✓',
			warning: '!',
			error: '✗',
			missing: '✗',
			unconfigured: '–',
		} %}
		{% set og_section_attrs = create_attribute({
			id: 'og-image',
			class: 'mb-12',
			'data-og-status': og_audit.status,
		}) %}
		<section{{ og_section_attrs }}>
			<div class="flex gap-3 items-center mb-6">
				<div class="flex justify-center items-center w-8 h-8 rounded-lg bg-zinc-200 text-zinc-600">
					<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
					</svg>
				</div>
				<h2 class="font-bold text-lg text-zinc-900">{{ styleguide.labels.og_image|default('Open Graph image')|e }}</h2>
			</div>

			{% if not og_audit.configured %}
				{# Empty state — deliberately loud (not just an absent section)
				   since an OG image is expected on every project. #}
				<div class="flex flex-col gap-2 items-center p-10 text-center rounded-xl border-2 border-dashed border-zinc-300">
					<p class="font-semibold text-sm text-zinc-600">{{ styleguide.labels.og_empty|default('No og_image configured — add one so shared links get a real preview image.')|e }}</p>
					<p class="font-mono text-xs text-zinc-400">og_image: /images/og-image.png</p>
				</div>
			{% else %}
				{# Three simulated share cards — pure divs/img, no external assets. Each falls
				   back to a dashed empty-state tile when the audit couldn't resolve the file. #}
				<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
					<div class="overflow-hidden p-6 border border-zinc-200 rounded-xl shadow-lg shadow-zinc-200/50 bg-white">
						<p class="mb-4 font-semibold text-xs text-zinc-500 uppercase tracking-wider">{{ styleguide.labels.og_facebook|default('Facebook / LinkedIn')|e }}</p>
						<div class="overflow-hidden rounded-lg border border-zinc-200" data-og-card="facebook">
							<div class="overflow-hidden w-full bg-zinc-100 aspect-[1.91/1]">
								{% if og_audit.exists %}
									{# twig-cs-fixer-disable-next-line PlainImg — mockup share-card image sourced from the server-side audit, not a CMS image #}
									<img src="{{ og_audit.path|e('html_attr') }}" alt="" class="object-cover w-full h-full">
								{% else %}
									<div class="flex justify-center items-center w-full h-full text-xs text-zinc-400">{{ styleguide.labels.og_missing|default('Image not found')|e }}</div>
								{% endif %}
							</div>
							<div class="p-3 bg-zinc-50">
								<p class="text-xs text-zinc-500 uppercase tracking-wide">{{ styleguide.labels.og_domain_placeholder|default('yoursite.com')|e }}</p>
								<p class="font-semibold text-sm text-zinc-900 truncate">{{ styleguide.project.name|default('')|e }}</p>
							</div>
						</div>
					</div>

					<div class="overflow-hidden p-6 border border-zinc-200 rounded-xl shadow-lg shadow-zinc-200/50 bg-white">
						<p class="mb-4 font-semibold text-xs text-zinc-500 uppercase tracking-wider">{{ styleguide.labels.og_x|default('X (Twitter)')|e }}</p>
						<div class="overflow-hidden rounded-2xl border border-zinc-200" data-og-card="x">
							<div class="overflow-hidden w-full bg-zinc-100 aspect-[2/1]">
								{% if og_audit.exists %}
									{# twig-cs-fixer-disable-next-line PlainImg — mockup share-card image sourced from the server-side audit, not a CMS image #}
									<img src="{{ og_audit.path|e('html_attr') }}" alt="" class="object-cover w-full h-full">
								{% else %}
									<div class="flex justify-center items-center w-full h-full text-xs text-zinc-400">{{ styleguide.labels.og_missing|default('Image not found')|e }}</div>
								{% endif %}
							</div>
						</div>
					</div>

					<div class="overflow-hidden p-6 border border-zinc-200 rounded-xl shadow-lg shadow-zinc-200/50 bg-white">
						<p class="mb-4 font-semibold text-xs text-zinc-500 uppercase tracking-wider">{{ styleguide.labels.og_slack|default('Slack unfurl')|e }}</p>
						<div class="flex overflow-hidden rounded-md border border-zinc-200" data-og-card="slack">
							<span class="w-1 shrink-0 bg-zinc-300"></span>
							<div class="flex flex-col gap-2 p-3 min-w-0">
								<p class="font-semibold text-sm text-zinc-900 truncate">{{ styleguide.project.name|default('')|e }}</p>
								<div class="overflow-hidden w-32 bg-zinc-100 rounded aspect-[1.91/1]">
									{% if og_audit.exists %}
										{# twig-cs-fixer-disable-next-line PlainImg — mockup share-card image sourced from the server-side audit, not a CMS image #}
										<img src="{{ og_audit.path|e('html_attr') }}" alt="" class="object-cover w-full h-full">
									{% else %}
										<div class="flex justify-center items-center w-full h-full text-[10px] text-center text-zinc-400">{{ styleguide.labels.og_missing|default('Image not found')|e }}</div>
									{% endif %}
								</div>
							</div>
						</div>
					</div>
				</div>

				{# Compact server-side audit summary — same status vocabulary/badge
				   colours as the favicon table above, one row per check. #}
				<div class="overflow-hidden overflow-x-auto border border-zinc-200 rounded-xl shadow-lg shadow-zinc-200/50 bg-white">
					<table class="w-full text-sm">
						<thead>
							<tr class="text-xs tracking-wider text-left text-zinc-500 uppercase bg-zinc-50 border-b border-zinc-100">
								<th class="px-4 py-2">{{ styleguide.labels.og_col_path|default('Path')|e }}</th>
								<th class="px-4 py-2">{{ styleguide.labels.og_col_dimensions|default('Dimensions')|e }}</th>
								<th class="px-4 py-2">{{ styleguide.labels.og_col_filesize|default('File size')|e }}</th>
								<th class="px-4 py-2">{{ styleguide.labels.og_col_status|default('Status')|e }}</th>
								<th class="px-4 py-2">{{ styleguide.labels.og_col_note|default('Note')|e }}</th>
							</tr>
						</thead>
						<tbody>
							<tr class="border-b border-zinc-50 last:border-b-0">
								<td class="px-4 py-2 font-mono text-xs text-zinc-500"><code>{{ og_audit.path|e }}</code></td>
								<td class="px-4 py-2 font-mono text-xs text-zinc-500">{% if og_audit.width is not null and og_audit.height is not null %}{{ og_audit.width }}×{{ og_audit.height }}{% endif %}</td>
								<td class="px-4 py-2 font-mono text-xs text-zinc-500">{% if og_audit.filesize is not null %}{{ (og_audit.filesize / 1024)|round(1) }} KB{% endif %}</td>
								<td class="px-4 py-2">
									{% set og_badge_attrs = create_attribute({
										class: [
											'inline-flex gap-1 items-center px-2 py-0.5 rounded-full text-xs font-semibold',
											og_status_classes[og_audit.status]|default('bg-zinc-100 text-zinc-400'),
										],
									}) %}
									<span{{ og_badge_attrs }}>{{ og_status_glyphs[og_audit.status]|default('?') }} {{ (styleguide.labels['og_status_' ~ og_audit.status]|default(og_audit.status))|e }}</span>
								</td>
								<td class="px-4 py-2 text-xs text-zinc-500">
									{% for note in og_audit.notes %}
										<div>{{ note|e }}</div>
									{% endfor %}
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			{% endif %}
		</section>
	{% endif %}

	{% if styleguide.colors %}
		{% set colors_section_attrs = create_attribute({
			id: 'colors',
			class: 'mb-12',
			'data-sg-colors': true,
			'data-label-copied': styleguide.labels.copied,
			'data-label-copy': styleguide.labels.click_to_copy,
		}) %}
		<section{{ colors_section_attrs }}>
			<div class="flex gap-3 items-center mb-6">
				<div class="flex justify-center items-center w-8 h-8 rounded-lg bg-zinc-200 text-zinc-600">
					<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
					</svg>
				</div>
				<h2 class="font-bold text-lg text-zinc-900">{{ styleguide.labels.colors|e }}</h2>
			</div>

			<div class="flex flex-col lg:flex-row lg:flex-wrap xl:flex-nowrap gap-6">
				{% for palette in styleguide.colors %}
					{% set default_swatch = palette.swatches|filter(s => s.key == palette.default)|first %}
					{% set color_card_attrs = create_attribute({
						class: [
							'overflow-hidden flex-1 min-w-0',
							'lg:w-[calc(50%-0.75rem)] xl:w-auto',
							'border border-zinc-200 rounded-xl shadow-lg shadow-zinc-200/50 bg-white',
						],
						'data-palette': palette.key,
					}) %}
					<div{{ color_card_attrs }}>
						{% set hero_attrs = create_attribute({
							class: 'group relative h-32 cursor-pointer duration-300 transition-colors',
							'data-hero': true,
							style: "background-color: #{default_swatch.bg};",
						}) %}
						<div{{ hero_attrs }}>
							{% set hero_text_attrs = create_attribute({
								class: [
									'flex absolute inset-0 justify-between items-center p-5 duration-300 transition-colors',
									default_swatch.light ? 'text-zinc-900' : 'text-white',
								],
								'data-hero-text': true,
							}) %}
							<div{{ hero_text_attrs }}>
								<div>
									<p class="opacity-70 font-semibold text-xs uppercase tracking-wider">{{ palette.name|e }}</p>
									<p class="mt-1 font-bold text-2xl" data-hero-label>{{ default_swatch.label|e }}</p>
								</div>
								<div class="text-right">
									<p class="opacity-90 font-mono text-sm" data-hero-hex>{{ default_swatch.hex|e }}</p>
									<p class="opacity-60 font-mono text-xs" data-hero-oklch>{{ default_swatch.oklch|e }}</p>
									<p class="opacity-75 font-mono text-xs" data-hero-contrast>W {{ default_swatch.contrast_white }}{{ default_swatch.aa_white ? ' AA' : '' }} · B {{ default_swatch.contrast_black }}{{ default_swatch.aa_black ? ' AA' : '' }}</p>
									<p class="mt-1 opacity-60 font-mono text-xs">{{ styleguide.labels.click_swatch|e }}</p>
								</div>
							</div>
							<div class="flex absolute inset-0 justify-center items-center opacity-0 group-hover:opacity-100 bg-black/20 transition-opacity" data-copy-overlay>
								<span class="px-3 py-1.5 rounded-full bg-black/40 font-medium text-sm text-white" data-copy-feedback>{{ styleguide.labels.click_to_copy|e }}</span>
							</div>
						</div>
						<div class="p-4">
							<div class="flex flex-wrap gap-1">
								{% for swatch in palette.swatches %}
									{% set is_default_swatch = swatch.key == palette.default %}
									<button
										type="button"
										class="group/swatch relative flex-1 min-w-8 max-w-16"
										data-swatch="{{ swatch|json_encode|e('html_attr') }}"
										{% if is_default_swatch %}data-swatch-default{% endif %}
									>
										{% set swatch_attrs = create_attribute({
											class: [
												'aspect-square relative group-hover/swatch:z-10 rounded-md',
												'group-hover/swatch:shadow-lg duration-200 transition-all group-hover/swatch:scale-110',
												is_default_swatch ? 'ring-2 ring-zinc-950' : '',
											],
											'data-swatch-tile': true,
											style: "background-color: #{swatch.bg};",
										}) %}
										<div{{ swatch_attrs }}>
											<span class="flex absolute right-0.5 bottom-0.5 gap-0.5">
												{% if swatch.aa_white %}<span class="w-1.5 h-1.5 rounded-full bg-white shadow-sm" title="AA white"></span>{% endif %}
												{% if swatch.aa_black %}<span class="w-1.5 h-1.5 rounded-full bg-black shadow-sm" title="AA black"></span>{% endif %}
											</span>
										</div>
										{% set swatch_key_attrs = create_attribute({
											class: [
												'mt-2 font-mono text-[10px] text-zinc-500 group-hover/swatch:text-zinc-900 text-center truncate transition-colors',
												is_default_swatch ? 'font-bold text-zinc-900' : '',
											],
											'data-swatch-key': true,
										}) %}
										<p{{ swatch_key_attrs }}>{{ swatch.key|e }}</p>
										{% set swatch_tooltip_attrs = create_attribute({
											class: [
												'absolute bottom-full left-1/2 z-20 -translate-x-1/2',
												'px-2 py-1 mb-2 rounded',
												'opacity-0 group-hover/swatch:opacity-100 transition-opacity',
												'bg-zinc-900 font-mono text-[10px] text-white whitespace-nowrap pointer-events-none',
											],
										}) %}
										<div{{ swatch_tooltip_attrs }} data-contrast="W {{ swatch.contrast_white }} B {{ swatch.contrast_black }}">
											<span>{{ swatch.hex|e }}</span>
											<span class="block opacity-70">W {{ swatch.contrast_white }}{{ swatch.aa_white ? ' AA' : '' }} · B {{ swatch.contrast_black }}{{ swatch.aa_black ? ' AA' : '' }}</span>
										</div>
									</button>
								{% endfor %}
							</div>
						</div>
					</div>
				{% endfor %}
			</div>

			{% if styleguide.colors_contrast.colors %}
				<div id="contrast-matrix" class="mt-8">
					<button
						type="button"
						class="flex gap-2 items-center font-semibold text-sm text-zinc-600 hover:text-zinc-900 transition-colors"
						data-sg-toggle="contrast-matrix-table"
					>
						<svg class="w-4 h-4 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
						</svg>
						{{ styleguide.labels.contrast_matrix|default('Contrast matrix (WCAG)')|e }}
					</button>
					<div id="contrast-matrix-table" class="overflow-x-auto mt-4" hidden>
						<table class="border-separate border-spacing-1">
							<thead>
								<tr>
									<th class="sticky left-0 z-10 bg-zinc-50"></th>
									{% for color in styleguide.colors_contrast.colors %}
										<th class="p-1">
											{% set thead_swatch_attrs = create_attribute({
												class: 'block mx-auto w-6 h-6 rounded border border-zinc-200',
												style: "background-color: #{color.bg};",
												title: color.label,
											}) %}
											<span{{ thead_swatch_attrs }}></span>
										</th>
									{% endfor %}
								</tr>
							</thead>
							<tbody>
								{% for row in styleguide.colors_contrast.colors %}
									{% set row_index = loop.index0 %}
									<tr>
										<th class="sticky left-0 z-10 py-1 pr-2 bg-zinc-50 text-left">
											<span class="flex gap-2 items-center">
												{% set row_swatch_attrs = create_attribute({
													class: 'shrink-0 w-4 h-4 rounded border border-zinc-200',
													style: "background-color: #{row.bg};",
												}) %}
												<span{{ row_swatch_attrs }}></span>
												<span class="font-mono font-medium text-[10px] text-zinc-600 whitespace-nowrap">{{ row.label|e }}</span>
											</span>
										</th>
										{% for cell in styleguide.colors_contrast.cells[row_index] %}
											{% set col = styleguide.colors_contrast.colors[loop.index0] %}
											{% set cell_attrs = create_attribute({
												class: [
													'px-1.5 py-1 min-w-14 rounded text-center align-middle',
													cell.level == 'fail' ? 'opacity-40' : '',
												],
												style: "background-color: #{col.bg}; color: #{row.hex};",
												'data-ratio': cell.ratio,
												title: "#{row.label} on #{col.label}: #{cell.ratio}",
											}) %}
											<td{{ cell_attrs }}>
												<span class="block font-mono font-semibold text-[10px]">{{ cell.ratio }}</span>
												<span class="block font-mono text-[9px] uppercase opacity-80">{{ cell.level == 'aa-large' ? 'AA18' : (cell.level == 'fail' ? '×' : cell.level|upper) }}</span>
											</td>
										{% endfor %}
									</tr>
								{% endfor %}
							</tbody>
						</table>
						<p class="mt-2 font-mono text-[10px] text-zinc-500">{{ styleguide.labels.contrast_matrix_legend|default('AAA ≥ 7 · AA ≥ 4.5 · AA18 (large text) ≥ 3 · × below 3. Cell = row color as text on column color.')|e }}</p>
					</div>
				</div>
			{% endif %}
		</section>
	{% endif %}

	{% if styleguide.typography %}
		<section id="typography" class="mb-12">
			<div class="flex gap-3 items-center mb-6">
				<div class="flex justify-center items-center w-8 h-8 rounded-lg bg-zinc-200 text-zinc-600">
					<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h8m-8 6h16"/>
					</svg>
				</div>
				<h2 class="font-bold text-lg text-zinc-900">{{ styleguide.labels.typography|e }}</h2>
			</div>

			{% if styleguide.typography.fonts %}
			{% for font in styleguide.typography.fonts %}
				<div class="overflow-hidden mb-6 border border-zinc-200 rounded-xl shadow-lg shadow-zinc-200/50 bg-white">
					<div class="p-6 md:p-8 border-b border-zinc-100">
						<div class="flex flex-col sm:flex-row gap-4 sm:justify-between sm:items-center">
							<div>
								<p class="mb-2 font-semibold text-xs text-zinc-500 uppercase tracking-wider">{{ styleguide.labels.font_family|e }}</p>
								{% if font.url %}
									<a href="{{ font.url|e('html_attr') }}" target="_blank" rel="noopener" class="group inline-flex gap-2 items-center">
										<span class="font-bold text-3xl md:text-4xl text-zinc-900 group-hover:text-zinc-600 tracking-tight transition-colors">{{ font.name|e }}</span>
										<svg class="w-5 h-5 text-zinc-500 group-hover:text-zinc-600 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
											<path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
										</svg>
									</a>
								{% else %}
									<span class="font-bold text-3xl md:text-4xl text-zinc-900 tracking-tight">{{ font.name|e }}</span>
								{% endif %}
							</div>
							<div class="flex flex-wrap gap-2">
								{% if font.type %}
									<span class="inline-flex items-center px-3 py-1.5 rounded-lg bg-zinc-100 font-semibold text-xs text-zinc-700">{{ font.type|e }}</span>
								{% endif %}
								{% for usage in font.usage %}
									<span class="inline-flex items-center px-3 py-1.5 rounded-lg bg-zinc-100 font-semibold text-xs text-zinc-700">{{ usage|e }}</span>
								{% endfor %}
							</div>
						</div>
					</div>
					{% if font.alphabet %}
						<div class="p-6 md:p-8 bg-zinc-50">
							<p class="font-medium text-2xl md:text-3xl text-zinc-800 whitespace-pre-line leading-relaxed tracking-wide">{{ font.alphabet|e }}</p>
						</div>
					{% endif %}
				</div>
			{% endfor %}
			{% endif %}

			{% if styleguide.typography.headings %}
				<div class="overflow-hidden mb-6 border border-zinc-200 rounded-xl shadow-lg shadow-zinc-200/50 bg-white">
					<div class="p-4 md:p-6 border-b border-zinc-100 bg-white">
						<p class="font-semibold text-xs text-zinc-500 uppercase tracking-wider">{{ styleguide.labels.headings|e }}</p>
					</div>
					<div class="divide-y divide-zinc-100">
						{% for heading in styleguide.typography.headings %}
							<div class="group flex flex-col md:flex-row gap-3 md:gap-6 md:items-center p-4 md:p-6 hover:bg-white transition-colors">
								<div class="shrink-0 w-20">
									<span class="inline-flex items-center px-2.5 py-1 rounded-md bg-zinc-100 font-mono font-semibold text-xs text-zinc-600">&lt;{{ heading.tag|e }}&gt;</span>
								</div>
								<div class="flex-1 min-w-0">
									<p class="{{ heading.size|e('html_attr') }} font-bold font-headings text-zinc-900 tracking-tight truncate">{{ heading.label|e|typography }}</p>
								</div>
								<div class="shrink-0 text-right">
									<span class="font-mono text-xs text-zinc-500">{{ heading.desc|e }}</span>
								</div>
							</div>
						{% endfor %}
					</div>
				</div>
			{% endif %}

			{% if styleguide.typography.weights %}
				<div class="overflow-hidden mb-6 border border-zinc-200 rounded-xl shadow-lg shadow-zinc-200/50 bg-white">
					<div class="p-4 md:p-6 border-b border-zinc-100 bg-white">
						<p class="font-semibold text-xs text-zinc-500 uppercase tracking-wider">{{ styleguide.labels.font_weights|e }}</p>
					</div>
					<div class="flex flex-col sm:flex-row sm:flex-wrap xl:flex-nowrap">
						{% for weight in styleguide.typography.weights %}
							{% set weight_cell_attrs = create_attribute({
								class: [
									'group flex-1 p-6 min-w-0',
									'sm:w-1/3 xl:w-auto',
									'border-b last:border-b-0 last:border-r-0 sm:border-b-0 sm:border-r xl:border-r border-zinc-100',
									'hover:bg-white text-center transition-colors',
								],
							}) %}
							<div{{ weight_cell_attrs }}>
								<p class="text-4xl {{ weight.class|e('html_attr') }} text-zinc-900 mb-3">Aa</p>
								<p class="font-medium text-sm text-zinc-700">{{ weight.name|e }}</p>
								<p class="mt-1 font-mono text-xs text-zinc-500">{{ weight.value|e }}</p>
							</div>
						{% endfor %}
					</div>
				</div>
			{% endif %}

			{% if styleguide.typography.body_sample %}
				{% set prose_variants = [
					{ modifier: 'prose-sm', label: '.prose-sm', range: '14 → 18 px · weight 300 · lh 1.6' },
					{ modifier: '', label: '.prose', range: '16 → 24 px · weight 300 · lh 1.55' },
					{ modifier: 'prose-lg', label: '.prose-lg', range: '20 → 30 px · weight 500 · lh 1.4' },
					{ modifier: 'prose-xl', label: '.prose-xl', range: '24 → 36 px · weight 400 · lh 1.35' },
					{ modifier: 'prose-2xl', label: '.prose-2xl', range: '28 → 48 px · weight 400 · lh 1.3' },
				] %}
				<div class="overflow-hidden border border-zinc-200 rounded-xl shadow-lg shadow-zinc-200/50 bg-white">
					<div class="p-4 md:p-6 border-b border-zinc-100 bg-white">
						<p class="font-semibold text-xs text-zinc-500 uppercase tracking-wider">{{ styleguide.labels.body_text|e }}</p>
					</div>
					<div class="grid grid-cols-1 xl:grid-cols-2">
						<div class="divide-y divide-zinc-100">
							{% for v in prose_variants %}
								<div class="p-6 md:p-8">
									<div class="flex flex-wrap gap-3 items-center mb-3">
										<span class="inline-flex items-center px-2.5 py-1 rounded-md bg-zinc-100 font-mono font-semibold text-xs text-zinc-600">{{ v.label }}</span>
										<span class="font-mono text-xs text-zinc-500">{{ v.range }}</span>
									</div>
									<p class="prose {{ v.modifier }} max-w-prose text-zinc-700">
										{{ styleguide.typography.body_sample|e|typography }}
									</p>
								</div>
							{% endfor %}
						</div>
						<div class="divide-y divide-white/10 bg-zinc-900 border-t border-zinc-100 xl:border-t-0 xl:border-l">
							{% for v in prose_variants %}
								<div class="p-6 md:p-8">
									<div class="flex flex-wrap gap-3 items-center mb-3">
										<span class="inline-flex items-center px-2.5 py-1 rounded-md bg-white/10 font-mono font-semibold text-xs text-zinc-300">{{ v.label }} .prose-invert</span>
										<span class="font-mono text-xs text-zinc-400">{{ v.range }}</span>
									</div>
									<p class="prose {{ v.modifier }} prose-invert max-w-prose">
										{{ styleguide.typography.body_sample|e|typography }}
									</p>
								</div>
							{% endfor %}
						</div>
					</div>
				</div>
			{% endif %}
		</section>
	{% endif %}
</div>
