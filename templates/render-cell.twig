{# vendor/parisek/styleguide — iframe HTML wrapper for component/page preview #}
<!DOCTYPE html>
<html lang="{{ langcode|default('en')|e }}"{% if iframe.html_class %} class="{{ iframe.html_class|e }}"{% endif %}>
<head>
	<script>document.documentElement.classList.remove('no-js');</script>
	{# Lock the iframe to a light backdrop regardless of OS `prefers-color-scheme`
	   or the parent SPA's dark mode toggle. Two things are at play:
	   1. `color-scheme: light` tells Chrome to render the iframe's canvas
	      light (default form controls, scrollbars).
	   2. Explicit `background: white` on <body> handles the case where the
	      consumer's foundations / page template leaves portions of the
	      document transparent — without this, Chrome's user-agent style
	      paints the iframe element dark in OS dark mode, bleeding through
	      transparent content. Setting it on `<body>` (not `<html>`) keeps
	      consumer CSS able to override with their own body bg without an
	      `!important` battle.
	   Consumer projects that want iframe content to follow OS dark can
	   override both with their own `:root { color-scheme: dark light }`
	   and a body background-color declaration in their stylesheet. #}
	<style>
		:root { color-scheme: light; }
		body { background-color: #fff; }{# Per-mode CSS injections for the iframe wrapper.
		   `bleed` / `chrome` / `overlay` all reset `--header-height` to 0
		   so consumer "tuck under sticky header" hacks collapse cleanly
		   in styleguide isolation; `chrome` additionally forces body to
		   200vh so sticky / fixed chrome has scroll-room to demo. #}
		{%- if kind == 'component' and component.render in ['bleed', 'chrome', 'overlay'] %} :root { --header-height: 0px; } {%- endif -%}
		{%- if kind == 'component' and component.render == 'chrome' %} body { min-height: 200vh; } {%- endif -%}
	</style>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="robots" content="noindex,nofollow">
	<title>{{ component.name|default(component.id)|e }} — {{ project.name|default('Styleguide')|e }}</title>
	{% if project.favicon %}<link rel="icon" href="{{ project.favicon|e }}">{% endif %}
	{% if iframe.base_href %}<base href="{{ iframe.base_href|e }}">{% endif %}
	{# Fonty — samostatné stylesheets s @font-face deklaracemi. `|cachebust`
	   appends ?v=<mtime> so a rebuild instantly invalidates the browser
	   cache without per-project Apache / nginx config. #}
	{% for url in iframe.fonts|default([]) %}<link rel="stylesheet" href="{{ url|cachebust|e }}">
	{% endfor %}
	{# Hlavní bundled CSS (Tailwind / Bootstrap / custom — vše v jednom souboru). #}
	{% if iframe.css %}<link rel="stylesheet" href="{{ iframe.css|cachebust|e }}">{% endif %}
	{# Package-shipped Tailwind bundle for the foundations route. The consumer's
	   iframe.css scans its own templates/ but not vendor/, so utility classes
	   used only by templates/foundations.twig (h-32, max-w-48, prose-*, …)
	   would otherwise be absent. Loaded after iframe.css so consumer overrides
	   still win on shared classes. #}
	{% if foundations_css_url %}<link rel="stylesheet" href="{{ foundations_css_url|e }}">{% endif %}
	{# Hlavní bundled JS — loaded as ES module (Vite builds top-level `export`/`import` statements). #}
	{% if iframe.js %}<script type="module" src="{{ iframe.js|cachebust|e }}"></script>{% endif %}
</head>
<body{% if iframe.body_class %} class="{{ iframe.body_class|e }}"{% endif %}>
	{# Tiny standalone-mode navbar — hidden in iframe (the default render target),
	   revealed by the inline script when the document is the top-level window so
	   "Open in new tab" lands on a usable page with a link back to the styleguide. #}
	{# Foundations is a sectionless route (`/styleguide/foundations`); component/page carry a slug. #}
	{% set sg_url = kind == 'foundations' ? '/styleguide/foundations' : '/styleguide/' ~ kind ~ '/' ~ slug %}
	{# Default to `display:none` (NOT the `hidden` HTML attribute) because the bar's
	   own inline `display:flex` would otherwise win the CSS cascade over the user-
	   agent `[hidden] { display: none }` rule (UA rules have lower specificity than
	   inline styles), making the bar permanently visible — including inside iframes
	   where it shouldn't appear at all. The reveal script below flips `display`
	   directly so the bar opens to its intended flex layout when this document is
	   the top-level window. #}
	<div id="sg-standalone-bar" style="display:none;position:sticky;top:0;z-index:9999;align-items:center;gap:12px;padding:8px 16px;background:#18181b;color:#e4e4e7;font:500 13px system-ui,-apple-system,Segoe UI,sans-serif;border-bottom:1px solid #27272a">
		{% if project.favicon %}<img src="{{ project.favicon|e }}" alt="" style="width:20px;height:20px;border-radius:4px;background:#fafafa">{% endif %}
		{# Back link — just the arrow. The project name lived next to it
		   historically but it's redundant with the favicon (same logical
		   signal: "you're inside this project's styleguide"). #}
		<a href="{{ sg_url|e }}" title="{{ project.name|default('Styleguide')|e }} — Styleguide" style="display:inline-flex;align-items:center;color:#a1a1aa;text-decoration:none">
			<span aria-hidden="true">←</span>
		</a>
		{# Friendly name + raw slug in parens. Mirrors how the SPA chrome's
		   breadcrumb shows components in the catalog view: humans read the
		   YAML `name:`, devs read the slug. Foundations has no slug, so we
		   skip the parens block when slug is empty. #}
		<span style="color:#fafafa">{{ component.name|default(slug)|e }}</span>
		{% if slug %}<span style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12px;color:#71717a">({{ slug|e }})</span>{% endif %}
		{# Close button — drops the bar so the standalone preview becomes a
		   truly clean canvas (no chrome eating top-of-viewport pixels). Bar
		   is sticky+sticky-coordinate (top:0), so DOM-removing it pushes
		   content up by its own height instantly without any further layout
		   coordination. Browser back button is still the return path; the
		   URL bar stays visible so navigation isn't lost. Inline onclick
		   keeps the bar self-contained — no project JS framework dependency. #}
		<button type="button"
		        onclick="this.parentElement.remove()"
		        title="Skrýt panel"
		        aria-label="Skrýt panel"
		        style="margin-left:auto;display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;background:none;border:0;color:#a1a1aa;cursor:pointer;border-radius:4px;padding:0">
			<svg aria-hidden="true" focusable="false" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
				<line x1="3" y1="3" x2="11" y2="11"/>
				<line x1="11" y1="3" x2="3" y2="11"/>
			</svg>
		</button>
	</div>
	<script>
		// Reveal the back-bar only when this document is the top-level window;
		// inside an iframe it stays hidden so the styleguide preview matches
		// what the component would look like in production.
		//
		// `?canvas=1` query param suppresses the bar even when top-level —
		// the SPA chrome's "Canvas" button passes that flag so the canvas view
		// is truly 100% viewport without the sticky bar stealing ~40px at the
		// top (which would push h-svh / h-screen content out of view). Users
		// return via the browser back button; the URL bar is visible in
		// canvas mode so the page is still navigable.
		if (window.self === window.top && !new URLSearchParams(location.search).has('canvas')) {
			document.getElementById('sg-standalone-bar').style.display = 'flex';
		}
	</script>
	{# Component-kind previews render a single small piece (button, breadcrumb, …)
	   that would otherwise sit flush against the iframe's top edge — visually
	   touching the styleguide chrome above. Pages render their own full layout
	   (which already controls spacing), so they don't get the inset. Inline
	   styles instead of utility classes so the inset works regardless of the
	   project's CSS framework (Tailwind / Bootstrap / custom). Only `inset`
	   mode (the default for unannotated components) gets the wrapper;
	   `bleed` / `chrome` / `overlay` render edge-to-edge so hero / slider /
	   sticky / modal components can fill the iframe. #}
	{% set use_inset = kind == 'component' and component.render == 'inset' %}
	{% if use_inset %}<div style="padding:1.5rem">{% endif %}
	{{ body|raw }}
	{% if use_inset %}</div>{% endif %}
</body>
</html>
