{# vendor/parisek/styleguide — Fields body (aggregated component fields metadata).
   Rendered inside the iframe by Renderer when kind=fields. Reads `fields_data`
   from the Twig context (populated by Styleguide::dispatchRender from
   ComponentParser::parseAll('component') filtered to components with non-empty
   `fields:` YAML metadata). Each entry shape: { component_id, component_name, fields[] }.
   Each `fields[]` entry's shape is project-defined — we render the keys that
   are commonly present (name / type / description / required) and pass anything
   else through the `dump` extension fallback for visibility. #}
<div class="px-4 py-6 md:px-6 md:py-8 lg:px-8">
	{% if styleguide.project %}
		<div class="mb-10">
			<h1 class="font-bold text-2xl sm:text-3xl lg:text-4xl text-zinc-900 tracking-tight">Fields</h1>
			<p class="mt-3 max-w-3xl text-base lg:text-lg text-zinc-600 leading-relaxed">Přehled polí napříč komponentami styleguidu — generováno z YAML metadat (<code class="font-mono text-sm">fields:</code> v hlavičce každé <code class="font-mono text-sm">.twig</code> šablony).</p>
		</div>
	{% endif %}

	{% if fields_data is empty %}
		<div class="rounded-xl border border-zinc-200 bg-white p-8 text-center text-zinc-500">
			<p>Žádné komponenty zatím nedeklarují fields metadata.</p>
			<p class="mt-2 text-sm">Přidej <code class="font-mono">fields:</code> blok do první <code class="font-mono">{# … #}</code> komenty komponenty.</p>
		</div>
	{% else %}
		<div class="space-y-6">
			{% for entry in fields_data %}
				<section class="overflow-hidden border border-zinc-200 rounded-xl shadow-sm bg-white">
					<header class="flex items-baseline gap-3 px-5 py-4 border-b border-zinc-100 bg-zinc-50">
						<h2 class="font-semibold text-base text-zinc-900">{{ entry.component_name }}</h2>
						<code class="font-mono text-xs text-zinc-500">{{ entry.component_id }}</code>
						<span class="ml-auto inline-flex items-center justify-center px-2 h-6 min-w-6 rounded-full bg-zinc-200 text-xs font-mono text-zinc-700">{{ entry.fields|length }}</span>
					</header>
					<table class="w-full text-sm">
						<thead class="text-left text-[10px] uppercase tracking-wider text-zinc-500">
							<tr class="border-b border-zinc-100">
								<th class="px-5 py-2 font-medium w-44">Name</th>
								<th class="px-5 py-2 font-medium w-32">Type</th>
								<th class="px-5 py-2 font-medium">Description</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-zinc-100">
							{% for field in entry.fields %}
								<tr class="hover:bg-zinc-50/60 transition-colors">
									<td class="px-5 py-3 align-top font-mono text-xs text-zinc-900">
										{{ field.name|default(field.key|default('—')) }}
										{% if field.required %}<span class="ml-1 text-rose-500" title="Required">*</span>{% endif %}
									</td>
									<td class="px-5 py-3 align-top">
										{% if field.type %}
											<span class="inline-flex items-center px-2 py-0.5 rounded-md bg-zinc-100 font-mono text-xs text-zinc-700">{{ field.type }}</span>
										{% else %}
											<span class="text-zinc-300">—</span>
										{% endif %}
									</td>
									<td class="px-5 py-3 align-top text-zinc-600 leading-relaxed">
										{{ field.description|default('') }}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</section>
			{% endfor %}
		</div>
	{% endif %}
</div>
